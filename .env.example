# ============================================================
# CryptoTrace-I4C — Environment Variables
# Member 6: Copy this to .env and fill in your real values
# ============================================================

# ── Member 3: Blockchain API Keys ──────────────────────────
# Register free at: https://www.trongrid.io
TRONGRID_API_KEY=your_trongrid_api_key_here

# Register free at: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Blockstream (Bitcoin) needs NO key — public API

# ── Backend Config ──────────────────────────────────────────
BACKEND_PORT=8000
ENVIRONMENT=development          # development | production

# ── CORS Origins (comma-separated) ─────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Optional: Database (if added later) ────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/cryptotrace
